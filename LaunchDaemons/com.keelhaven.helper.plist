<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keelhaven's privileged helper, registered by the app with
  SMAppService.daemon(plistName:) and copied into
  Keelhaven.app/Contents/Library/LaunchDaemons/ by project.yml.
  On demand only: launchd starts it when the app connects to the Mach
  service, and it exits on its own once idle.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.keelhaven.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/KeelhavenHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.keelhaven.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.keelhaven.Keelhaven</string>
	</array>
</dict>
</plist>
