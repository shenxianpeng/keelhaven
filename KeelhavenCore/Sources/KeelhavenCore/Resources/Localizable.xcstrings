{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "Keelhaven could not read some of the files in this plan's folders. Open System Settings › Privacy & Security › Full Disk Access, turn on Keelhaven, quit and reopen Keelhaven, then run the backup again." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Keelhaven 读不到这个计划里的一些文件。请打开「系统设置 › 隐私与安全性 › 完全磁盘访问权限」，打开 Keelhaven 的开关，然后退出并重新打开 Keelhaven，再运行备份。" } }
      }
    },
    "Keelhaven's backup engine is missing from the app. Reinstalling Keelhaven from keelhaven.app restores it." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Keelhaven 的备份引擎不在应用里了。从 keelhaven.app 重新安装 Keelhaven 即可恢复。" } }
      }
    },
    "The backup repository was not found. %@" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "找不到备份仓库。%@" } }
      }
    },
    "This destination already contains a backup repository. Each plan needs its own empty destination folder." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该位置已经有一个备份仓库了。每个备份计划需要一个自己的空文件夹。" } }
      }
    },
    "The backup repository is locked by another process. %@" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备份仓库正被其他程序占用。%@" } }
      }
    },
    "The repository password is incorrect. %@" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备份密码不正确。%@" } }
      }
    },
    "Backup command failed (exit code %lld). %@" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备份命令执行失败（错误码 %1$lld）。%2$@" } }
      }
    },
    "Could not understand restic's output. %@" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析 restic 的输出。%@" } }
      }
    },
    "Couldn't read the Keychain password — click Always Allow next time macOS asks." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取钥匙串密码——下次 macOS 弹出请求时，请点按“始终允许”。" } }
      }
    },
    "Could not read this plan's password from the Keychain (error %@)." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法从钥匙串读取该计划的密码（错误码 %@）。" } }
      }
    },
    "The password stored in the Keychain for this plan is unreadable. Delete the plan and set it up again." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "钥匙串中保存的该计划密码已无法读取。请删除此计划后重新创建。" } }
      }
    }
  }
}
