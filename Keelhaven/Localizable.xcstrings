    "Upload limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传限速"
          }
        }
      }
    },
    "User": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名"
          }
        }
      }
    },
    "Username (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名（可选）"
          }
        }
      }
    },
    "Uses your existing SSH keys (~/.ssh) or ssh-agent for authentication.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您已有的 SSH 密钥（~/.ssh）或 ssh-agent 进行认证。"
          }
        }
      }
    },
    "Verification": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证"
          }
        }
      }
    },
    "Verification failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证失败"
          }
        }
      }
    },
    "Verification, retention, excluded files, speed limits — all optional": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证、保留策略、排除规则、速度限制 —— 均为可选"
