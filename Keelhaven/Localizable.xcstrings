          "stringUnit": {
            "state": "translated",
            "value": "填写 REST 服务器 URL 后继续"
          }
        }
      }
    },
    "Enter the password of the existing repository. It is checked when you click Next.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入已有仓库的密码。点“下一步”时会进行验证。"
