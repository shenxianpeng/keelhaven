{
  "sourceLanguage": "en",
  "strings": {
    "%@ backed up so far": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已备份 %@"
          }
        }
      }
    },
    "%@ finished successfully.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已成功完成备份。"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %@"
          }
        }
      }
    },
    "%@, selected as backup drive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已选为备份硬盘"
          }
        }
      }
    },
    "%@, selected for backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已选择备份"
          }
        }
      }
    },
    "%@: %lld new files, %@ added.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：新增 %2$lld 个文件，共 %3$@。"
          }
        }
      }
    },
    "%@: no changes since the last backup, so no new snapshot was created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：与上次备份相比没有变化，因此没有创建新的备份点。"
          }
        }
      }
    },
    "%lld backups need attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld backups need attention"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个备份需要处理"
          }
        }
      }
    },
    "%lld new files and %lld changed, about %@ to store.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 %1$lld 个文件、改动 %2$lld 个，约需存入 %3$@。"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. %2$@"
          }
        }
      }
    },
    "*.log": {
      "shouldTranslate": false
    },
    "/Volumes/BackupDrive/Keelhaven": {
      "shouldTranslate": false
    },
    "/backups/mac": {
      "shouldTranslate": false
    },
    "1 backup needs attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 backup needs attention"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个备份需要处理"
          }
        }
      }
    },
    "10": {
      "shouldTranslate": false
    },
    "1–32": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1–32"
          }
        }
      }
    },
    "A backup or repository check for this plan is still running. Wait for it to finish, then delete the plan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个计划的备份或仓库校验还在进行中。等它结束后再删除。"
          }
        }
      }
    },
    "A month of history": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留一个月"
          }
        }
      }
    },
    "A password is required to encrypt the backup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要设置密码来加密备份"
          }
        }
