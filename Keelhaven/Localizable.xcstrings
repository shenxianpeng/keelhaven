    "Read-only — can't back up here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读硬盘——无法用于备份"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        }
      }
    },
    "Remove the username and password from the server URL — enter them in the fields above instead, so they're stored in the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把用户名和密码从服务器 URL 里去掉，改填到上方的字段中——这样它们会保存在钥匙串里。"
          }
        }
      }
    },
    "Removes the plan and its saved password from this Mac. Already backed-up data at the destination is not deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会从这台 Mac 上移除该计划和保存的密码。已经备份到目标位置的数据不会被删除。"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名"
          }
        }
      }
    },
    "Rename “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名“%@”"
