    "Files and folders matching these patterns are skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配这些规则的文件和文件夹将被跳过。"
          }
        }
      }
    },
    "Files read at once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时读取文件数"
          }
        }
      }
