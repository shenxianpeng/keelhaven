// Preview deployments of the site for every PR, so a docs change can be
// looked at rendered before it merges.
//
// Production stays on GitHub Pages (keelhaven.app, via website.yml) — this
// worker is only ever reached on its *.workers.dev preview URLs. There is no
// script: it is an assets-only worker that serves VitePress's build output.
//
// Deployed by .github/workflows/site-preview.yml, not by Cloudflare's own Git
// integration (which never got its root directory right). See docs/WEBSITE.md
// § Preview deployments for the two secrets it needs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keelhaven-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./.vitepress/dist",
    // VitePress writes 404.html; serve it instead of a bare 404.
    "not_found_handling": "404-page"
  }
}
